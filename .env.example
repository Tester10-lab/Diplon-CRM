# ====================================================================
# Diplon Travel CRM/ERP - Environment Configuration
# ====================================================================

# Runtime environment (Must be 'production' for live deployments)
NODE_ENV=production

# Server Port
PORT=5000

# MongoDB Atlas Replica Set Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/diplon-crm?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/diplon-crm?replicaSet=rs0

# Secure JWT signing secret (Required in production, 32+ characters recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_production_jwt_secret_key_here

# 32-byte Base64 Encoded Key for AES-256 field-level encryption (e.g. passport numbers)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your_base64_encryption_key_here

# HMAC-SHA512 Key for signature verification
SIGNING_KEY=your_signing_key_here

# CORS Allowed Origins (Comma-separated URLs for web frontend)
# Example: https://diplon-travel.vercel.app,https://admin.diplontravel.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000
